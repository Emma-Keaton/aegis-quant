# Aegis Quant — Backend environment (Render services: aegis-quant-api + aegis-quant-worker)
# Copy to backend/.env for local development. On Render these are set as service env vars.
# Required secrets are validated at startup when ENVIRONMENT=production.

# Process role: "web" (API + webhook) | "worker" (engines + telethon) | "all" (local dev)
AEGIS_ROLE=all
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Direct connection:
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Or pooler (recommended for production):
# DATABASE_POOL_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION-pooler.postgres.vercel-storage.com:6543/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# ── Security / Secrets ───────────────────────────────────────────────────────
# Generate: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SESSION_SECRET=change-me-32-bytes
ENCRYPTION_KEY=change-me-32-bytes-base64

# ── Telegram bot (Mini App) ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_BOT_USERNAME=aegisquantbot
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret
ADMIN_CHAT_ID=123456789
APP_URL=http://localhost:3000
# Public API URL used to register the webhook, e.g. https://aegis-quant-api.onrender.com
API_PUBLIC_URL=http://localhost:8000

# ── AI Services ──────────────────────────────────────────────────────────────
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
GEMINI_MODEL=gemini-2.5-flash
# Kronos — standalone forecasting service (Render: aegis-quant-kronos)
KRONOS_SERVICE_URL=https://aegis-quant-kronos.onrender.com
KRONOS_API_KEY=change-me-kronos-api-key

# ── Scraper accounts (worker / Telethon channel polling) ─────────────────────
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TWITTER_ACCOUNTS_JSON=[]
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Execution / Solana ───────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
WALLET_CONNECT_PROJECT_ID=
AUTO_CONFIDENCE_THRESHOLD=75

# ── Engine thresholds (optional defaults) ────────────────────────────────────
ENGINE_A_PRICE_CHANGE_THRESHOLD=0.02
ENGINE_A_VOLUME_SPIKE_THRESHOLD=3.0
ENGINE_A_SPREAD_BPS_THRESHOLD=10
ENGINE_A_FUNDING_FLIP_ENABLED=true
ENGINE_A_MIN_CONFIDENCE=0.70

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://aegis-quant.vercel.app
