# ============================================
# AEGIS QUANT - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values

# ── Supabase Database (REQUIRED) ───────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/_/settings/database
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Database connection (choose ONE):
# Direct connection (better for local/dev):
DATABASE_URL="postgresql://postgres.[YOUR_REF]:[PASSWORD]@db.[YOUR_REF].supabase.co:5432/postgres"

# Pooler connection (recommended for production/Render):
# DATABASE_POOL_URL="postgresql://postgres.[YOUR_REF]:[PASSWORD]@aws-0-[REGION]-pooler.postgres.vercel-storage.com:6543/postgres"

# ── Telegram Bot (REQUIRED) ────────────────────────────────────────
TELEGRAM_BOT_TOKEN="your_bot_token_from_botfather"
TELEGRAM_BOT_USERNAME="aegisquantbot"

# Admin access (REQUIRED - your Telegram chat ID)
ADMIN_CHAT_ID=123456789
TELEGRAM_ADMIN_CHAT_ID=123456789

# ── Security (REQUIRED) ────────────────────────────────────────────
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="your_32_byte_base64_key_here"

# Session secret
SESSION_SECRET="your_random_session_secret"

# ── AI Services (REQUIRED for analysis) ───────────────────────────
# Get keys from: https://aistudio.google.com/apikey
GEMINI_API_KEY_1="your_gemini_key_1"
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""

# Optional: Kronos AI forecasting
KRONOS_SERVICE_URL=""
KRONOS_API_URL="https://kronos-ai.onrender.com"
KRONOS_API_KEY=""

# Optional: Groq for social sentiment
GROQ_API_KEY=""

# ── Application ────────────────────────────────────────────────────
APP_URL="https://your-domain.com"
DEBUG=true
ENVIRONMENT="development"  # development, staging, production

# ── Redis (Optional - for caching) ─────────────────────────────────
# Use Upstash or local Redis
REDIS_URL="redis://localhost:6379/0"

# ── QuantDinger (Optional) ─────────────────────────────────────────
QUANTDINGER_BASE_URL="http://localhost:5000"
QUANTDINGER_AGENT_TOKEN=""
DISABLE_QUANTDINGER_TOKEN_AUTH=true

# ── Scraper Accounts (Optional) ────────────────────────────────────
TWITTER_ACCOUNTS_JSON="[]"
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=""
TELEGRAM_PHONE=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# ── Exchange API Keys (Set via frontend, not .env) ─────────────────
# These are stored encrypted in the database per-user
# Configure via the Wallet page in the app

# ── WalletConnect (Required for EVM wallet support) ───────────────
# Get free project ID at: https://cloud.walletconnect.com
WALLET_CONNECT_PROJECT_ID=""

# ── Solana RPC (Optional - defaults to public) ────────────────────
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
