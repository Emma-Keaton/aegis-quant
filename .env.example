# ENCRYPTION_KEY: Required 32-character key for encrypting exchange credentials via AES-256
ENCRYPTION_KEY="aegisquantsecretkey32charsneeded!"

# APP_URL: The URL where this app is hosted (for OAuth callbacks, webhooks, self-referential links)
APP_URL="http://localhost:3000"

# KRONOS_API_KEY: Optional Kronos AI sentiment analysis API key (hosted on Render)
# Falls back to mock data if not provided
KRONOS_API_KEY=""

# GEMINI API KEYS (Free Tier Rotation - 2-3 keys to stay in free tier)
# Get keys from: https://aistudio.google.com/apikey
# Models: gemini-2.5-flash (15 RPM, 1500 RPD) or gemini-2.5-flash-lite (30 RPM, 1500 RPD)
GEMINI_API_KEY_1=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
